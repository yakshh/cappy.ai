# =============================================================
# cappy.ai — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- AI Provider API Keys ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_secondary_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here

# --- JWT ---
SECRET_KEY=i_do_what_i_love_eventually_i_find_people_who_love_me_for_what_i_do_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- App ---
APP_NAME=cappy.ai
DEBUG=True

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=uploads

# --- ChromaDB ---
CHROMA_PERSIST_DIR=chroma_db

# --- SQLite ---
# Use a hosted PostgreSQL URL in production/Vercel.
DATABASE_URL=sqlite:///./cappy.db
